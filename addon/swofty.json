{
  "schema_version": 1,
  "id": "l0g4nn.input-overlay",
  "name": "F1 25 Input Overlay",
  "version": "0.1.4",
  "author": "L0G4NN",
  "description": "Throttle and brake history. Enable UDP 2025 to 127.0.0.1:20777. Experimental test build.",
  "kind": [
    "native"
  ],
  "compat": {
    "game": "f1_25",
    "launcher": ">=1.3.7"
  },
  "requires": [
    {
      "id": "swofty.core",
      "version": ">=0.1.0"
    }
  ],
  "experimental_features": [
    "overlay"
  ],
  "options": [
    {
      "id": "enabled",
      "type": "toggle",
      "label": "Show overlay",
      "default": true,
      "binds": "native"
    },
    {
      "id": "bars",
      "type": "toggle",
      "label": "Show input bars",
      "default": true,
      "binds": "native"
    },
    {
      "id": "history",
      "type": "slider",
      "label": "History (seconds)",
      "default": 5,
      "min": 2,
      "max": 15,
      "step": 1,
      "binds": "native"
    },
    {
      "id": "width",
      "type": "slider",
      "label": "Width",
      "default": 420,
      "min": 280,
      "max": 900,
      "step": 10,
      "binds": "native"
    },
    {
      "id": "height",
      "type": "slider",
      "label": "Height",
      "default": 160,
      "min": 120,
      "max": 360,
      "step": 5,
      "binds": "native"
    },
    {
      "id": "opacity",
      "type": "slider",
      "label": "Background opacity (%)",
      "default": 25,
      "min": 0,
      "max": 100,
      "step": 1,
      "binds": "native"
    },
    {
      "id": "anchor",
      "type": "slider",
      "label": "Corner: 0 bottom-left, 1 bottom-right, 2 top-left, 3 top-right",
      "default": 0,
      "min": 0,
      "max": 3,
      "step": 1,
      "binds": "native"
    },
    {
      "id": "horizontal",
      "type": "slider",
      "label": "Horizontal position from selected corner (%)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "binds": "native"
    },
    {
      "id": "vertical",
      "type": "slider",
      "label": "Vertical position from selected corner (%)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "binds": "native"
    }
  ],
  "operations": {
    "native": [
      {
        "dll": "native/input_overlay.dll"
      }
    ]
  },
  "repository": "https://github.com/L0G4NN/F125-Input-Overlay"
}
